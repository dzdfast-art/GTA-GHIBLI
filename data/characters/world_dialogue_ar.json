    "nader_harbor": {
      "name_ar": "نادر",
      "lines": [
        {
          "line_id": "nader_001",
          "text_ar": "أهلاً بك! إذا تعطلت سيارتك في المدينة، تعال إليّ قبل أن تدفع مالك للغرباء.",
