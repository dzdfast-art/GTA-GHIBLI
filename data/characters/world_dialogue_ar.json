          "audio_status": "generated_remote_cache_on_first_play"
        },
        {
          "line_id": "nader_002",
          "text_ar": "رأيت شاحنة سوداء قرب المخازن القديمة. لم يعجبني أمرها.",
          "emotion_ar": "قلق",
          "audio_path": "res://audio/characters/nader_harbor/nader_002.ogg",
          "audio_url": "https://resource2.heygen.ai/text_to_speech/b4838dbec0634015b826f1957c74788a/24c7556125674f17bc2c4904074827e5/id=b4f640bf9a08444f96e21ca83e6701fe.mp3",
          "audio_status": "generated_remote_cache_on_first_play"
        }
      ]
    },
    "salma_harbor": {
      "name_ar": "سلمى",
      "lines": [
        {
          "line_id": "salma_001",
          "text_ar": "تصل إلى الميناء أخبار أكثر مما تصل إليه البضائع.",
