          "audio_status": "generated_remote_cache_on_first_play"
        },
        {
          "line_id": "rami_002",
          "text_ar": "سمعت نداء غزال قرب النهر عند الفجر.",
          "emotion_ar": "متأمل",
          "audio_path": "res://audio/characters/rami_pines/rami_002.ogg",
          "audio_url": "https://resource2.heygen.ai/text_to_speech/b4838dbec0634015b826f1957c74788a/24c7556125674f17bc2c4904074827e5/id=3e0afec26a8641fe8773ec855b07062c.mp3",
          "audio_status": "generated_remote_cache_on_first_play"
