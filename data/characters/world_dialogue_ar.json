{
  "schema_version": 1,
  "language": "ar",
  "status": "arabic_dialogue_ready_voice_recordings_pending",
  "note_ar": "جميع الجمل لديها مسارات صوت محددة. يجب إدراج تسجيلات OGG الفعلية في المسارات قبل سماع الدبلجة داخل اللعبة.",
  "characters": {
    "nader_harbor": {
      "name_ar": "نادر",
      "lines": [
        {
          "line_id": "nader_001",
          "text_ar": "أهلاً بك! إذا تعطلت سيارتك في المدينة، تعال إليّ قبل أن تدفع مالك للغرباء.",
          "emotion_ar": "مرح",
          "audio_path": "res://audio/characters/nader_harbor/nader_001.ogg"
        },
        {
          "line_id": "nader_002",
          "text_ar": "رأيت شاحنة سوداء قرب المخازن القديمة. لم يعجبني أمرها.",
          "emotion_ar": "قلق",
          "audio_path": "res://audio/characters/nader_harbor/nader_002.ogg"
        }
      ]
    },
    "salma_harbor": {
      "name_ar": "سلمى",
      "lines": [
        {
          "line_id": "salma_001",
          "text_ar": "تصل إلى الميناء أخبار أكثر مما تصل إليه البضائع.",
          "emotion_ar": "ودودة",
          "audio_path": "res://audio/characters/salma_harbor/salma_001.ogg"
        },
        {
          "line_id": "salma_002",
          "text_ar": "اسأل عن السفينة التي غادرت بعد منتصف الليل.",
          "emotion_ar": "متحفظة",
          "audio_path": "res://audio/characters/salma_harbor/salma_002.ogg"
        }
      ]
    },
    "rami_pines": {
      "name_ar": "رامي",
      "lines": [
        {
          "line_id": "rami_001",
          "text_ar": "لا تسرع في الطريق الجبلي إذا بدأ الضباب.",
          "emotion_ar": "هادئ",
          "audio_path": "res://audio/characters/rami_pines/rami_001.ogg"
        },
        {
          "line_id": "rami_002",
          "text_ar": "سمعت نداء غزال قرب النهر عند الفجر.",
          "emotion_ar": "متأمل",
          "audio_path": "res://audio/characters/rami_pines/rami_002.ogg"
        }
      ]
    },
    "hala_pines": {
      "name_ar": "هالة",
      "lines": [
        {
          "line_id": "hala_001",
          "text_ar": "في الجبال، دقيقة واحدة قد تصنع الفرق.",
          "emotion_ar": "حازمة",
          "audio_path": "res://audio/characters/hala_pines/hala_001.ogg"
        },
        {
          "line_id": "hala_002",
          "text_ar": "إذا رأيت شخصاً مصاباً، أبلغني وسأصل بسرعة.",
          "emotion_ar": "متعاطفة",
          "audio_path": "res://audio/characters/hala_pines/hala_002.ogg"
        }
      ]
    },
    "fares_valley": {
      "name_ar": "فارس",
      "lines": [
        {
          "line_id": "fares_001",
          "text_ar": "هذا الوادي يطعم الجميع إذا اعتنوا بأرضه.",
          "emotion_ar": "صريح",
          "audio_path": "res://audio/characters/fares_valley/fares_001.ogg"
        },
        {
          "line_id": "fares_002",
          "text_ar": "بعض الصناديق لم تكن تحمل ما كُتب عليها.",
          "emotion_ar": "متوجس",
          "audio_path": "res://audio/characters/fares_valley/fares_002.ogg"
        }
      ]
    },
    "layla_valley": {
      "name_ar": "ليلى",
      "lines": [
        {
          "line_id": "layla_001",
          "text_ar": "الماء حق للجميع، ولا يجب أن يتحكم به شخص واحد.",
          "emotion_ar": "واثقة",
          "audio_path": "res://audio/characters/layla_valley/layla_001.ogg"
        },
        {
          "line_id": "layla_002",
          "text_ar": "هناك من يعبث بمضخات المزارعين.",
          "emotion_ar": "غاضبة",
          "audio_path": "res://audio/characters/layla_valley/layla_002.ogg"
        }
      ]
    },
    "yasser_coast": {
      "name_ar": "ياسر",
      "lines": [
        {
          "line_id": "yasser_001",
          "text_ar": "البحر كريم لمن يحترمه.",
          "emotion_ar": "ودود",
          "audio_path": "res://audio/characters/yasser_coast/yasser_001.ogg"
        },
        {
          "line_id": "yasser_002",
          "text_ar": "مرّ قارب بلا أضواء قرب الساحل.",
          "emotion_ar": "قلق",
          "audio_path": "res://audio/characters/yasser_coast/yasser_002.ogg"
        }
      ]
    },
    "maryam_coast": {
      "name_ar": "مريم",
      "lines": [
        {
          "line_id": "maryam_001",
          "text_ar": "إذا احتجت إلى مساعدة في الماء، أطلق إشارة واضحة.",
          "emotion_ar": "مطمئنة",
          "audio_path": "res://audio/characters/maryam_coast/maryam_001.ogg"
        },
        {
          "line_id": "maryam_002",
          "text_ar": "لا تقترب من الصخور وقت العاصفة.",
          "emotion_ar": "حازمة",
          "audio_path": "res://audio/characters/maryam_coast/maryam_002.ogg"
        }
      ]
    },
    "nora_blake": {
      "name_ar": "نورا بليك",
      "role_ar": "صحفية استقصائية",
      "lines": [
        {
          "line_id": "nora_001",
          "text_ar": "أنا نورا بليك. أبحث عن الحقيقة حتى عندما يحاول الجميع إخفاءها.",
          "emotion_ar": "واثقة",
          "audio_path": "res://audio/characters/nora_blake/nora_001.ogg"
        },
        {
          "line_id": "nora_002",
          "text_ar": "اختفاء والدك ليس حادثاً عادياً. اسم الوسيط يتكرر في سجلات الميناء.",
          "emotion_ar": "جادة",
          "audio_path": "res://audio/characters/nora_blake/nora_002.ogg"
        }
      ]
    },
    "mia_bennett": {
      "name_ar": "ميا بينيت",
      "role_ar": "أخت ليو",
      "lines": [
        {
          "line_id": "mia_001",
          "text_ar": "ليو! كنت أعلم أنك ستعود. لدي ألف سؤال!",
          "emotion_ar": "فرح",
          "audio_path": "res://audio/characters/mia_bennett/mia_001.ogg"
        },
        {
          "line_id": "mia_002",
          "text_ar": "وجدت رسالة قديمة في صندوق أبي.",
          "emotion_ar": "قلق",
          "audio_path": "res://audio/characters/mia_bennett/mia_002.ogg"
        }
      ]
    },
    "claire_bennett": {
      "name_ar": "كلير بينيت",
      "role_ar": "والدة ليو وميا",
      "lines": [
        {
          "line_id": "claire_001",
          "text_ar": "الحمد لله أنك عدت يا ليو. البيت لم يكن كما كان في غيابك.",
          "emotion_ar": "حنان",
          "audio_path": "res://audio/characters/claire_bennett/claire_001.ogg"
        },
        {
          "line_id": "claire_002",
          "text_ar": "هناك أمور عن اختفاء والدك لم أستطع إخبارك بها.",
          "emotion_ar": "حزن",
          "audio_path": "res://audio/characters/claire_bennett/claire_002.ogg"
        }
      ]
    },
    "the_broker": {
      "name_ar": "الوسيط",
      "role_ar": "خصم غامض",
      "lines": [
        {
          "line_id": "broker_001",
          "text_ar": "في هذه المدينة، لكل سر ثمن. هل تستطيع دفعه؟",
          "emotion_ar": "بارد",
          "audio_path": "res://audio/characters/the_broker/broker_001.ogg"
        },
        {
          "line_id": "broker_002",
          "text_ar": "أنصحك أن تتوقف عن البحث يا ليو.",
          "emotion_ar": "تهديد",
          "audio_path": "res://audio/characters/the_broker/broker_002.ogg"
        }
      ]
    },
    "thomas_bennett": {
      "name_ar": "توماس بينيت",
      "role_ar": "والد ليو",
      "lines": [
        {
          "line_id": "thomas_001",
          "text_ar": "إذا كنت تسمع هذه الرسالة، فهذا يعني أنني لم أستطع العودة.",
          "emotion_ar": "ندم",
          "audio_path": "res://audio/characters/thomas_bennett/thomas_001.ogg"
        }
      ]
    }
  }
}