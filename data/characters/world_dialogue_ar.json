          "audio_status": "generated_remote_cache_on_first_play"
        }
      ]
    },
    "rami_pines": {
      "name_ar": "رامي",
      "lines": [
        {
          "line_id": "rami_001",
          "text_ar": "لا تسرع في الطريق الجبلي إذا بدأ الضباب.",
