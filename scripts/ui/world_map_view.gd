extends Control

const REGION_MARKERS := [
	{"id": "willow_village", "label": "WILLOW VILLAGE", "center": Vector2(0.0, 0.0), "color": Color(0.42, 0.52, 0.34)},
	{"id": "harbor_city", "label": "HARBOR CITY", "center": Vector2(-82.0, -54.0), "color": Color(0.36, 0.46, 0.56)},
	{"id": "pine_highlands", "label": "PINE HIGHLANDS", "center": Vector2(80.0, -52.0), "color": Color(0.31, 0.46, 0.33)},
	{"id": "amber_valley", "label": "AMBER VALLEY", "center": Vector2(-82.0, 52.0), "color": Color(0.59, 0.46, 0.29)},
	{"id": "sapphire_coast", "label": "SAPPHIRE COAST", "center": Vector2(82.0, 52.0), "color": Color(0.29, 0.48, 0.55)}
]

var _zoom := 1.0
var _pan := Vector2.ZERO
var _center_world := Vector2.ZERO
var _dragging := false

func _ready() -> void:
	mouse_filter = Control.MOUSE_FILTER_STOP
	process_mode = Node.PROCESS_MODE_ALWAYS
	set_process(true)
	queue_redraw()

func _process(_delta: float) -> void:
	if visible:
		queue_redraw()

func get_region_markers() -> Array:
	return REGION_MARKERS.duplicate(true)

func get_current_player_world_position() -> Vector2:
	var player := get_tree().get_first_node_in_group("player") as Node3D
	if player == null or not is_instance_valid(player):
		return Vector2.ZERO
	return Vector2(player.global_position.x, player.global_position.z)

func center_on_player() -> void:
	_center_world = get_current_player_world_position()
	_pan = Vector2.ZERO
	queue_redraw()

func zoom_by(amount: float) -> void:
	_zoom = clampf(_zoom + amount, 0.65, 2.4)
	queue_redraw()

func _gui_input(event: InputEvent) -> void:
	if event is InputEventScreenTouch:
		_dragging = event.pressed
		accept_event()
	elif event is InputEventScreenDrag and _dragging:
		_pan += event.relative
		queue_redraw()
		accept_event()
	elif event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT:
		_dragging = event.pressed
		accept_event()
	elif event is InputEventMouseMotion and _dragging:
		_pan += event.relative
		queue_redraw()
		accept_event()

func _draw() -> void:
	if size.x < 2.0 or size.y < 2.0:
		return
	draw_rect(Rect2(Vector2.ZERO, size), Color(0.035, 0.047, 0.043), true)
	var map_scale := minf((size.x - 36.0) / 300.0, (size.y - 36.0) / 230.0) * _zoom
	map_scale = maxf(map_scale, 0.25)
	var origin := size * 0.5 + _pan

	# Subtle cartographic grid.
	for world_x in range(-120, 121, 20):
		var a := _world_to_screen(Vector2(float(world_x), -100.0), origin, map_scale)
		var b := _world_to_screen(Vector2(float(world_x), 100.0), origin, map_scale)
		draw_line(a, b, Color(0.43, 0.48, 0.39, 0.18), 1.0)
	for world_z in range(-100, 101, 20):
		var a := _world_to_screen(Vector2(-130.0, float(world_z)), origin, map_scale)
		var b := _world_to_screen(Vector2(130.0, float(world_z)), origin, map_scale)
		draw_line(a, b, Color(0.43, 0.48, 0.39, 0.18), 1.0)

	# Coast water and the four actual district pads from open_world_regions.gd.
	_draw_world_polygon([Vector2(63.0, 58.0), Vector2(130.0, 58.0), Vector2(130.0, 112.0), Vector2(63.0, 112.0)], origin, map_scale, Color(0.10, 0.29, 0.38, 0.92))
	for region in REGION_MARKERS:
		var center: Vector2 = region.center
		if str(region.id) == "willow_village":
			continue
		var rect := _world_rect(center, Vector2(42.0, 34.0), origin, map_scale)
		draw_rect(rect, region.color, true)
		draw_rect(rect, Color(0.80, 0.72, 0.48, 0.85), false, 2.0)
		_draw_label(str(region.label), rect.position + Vector2(rect.size.x * 0.5, rect.size.y * 0.5), 12, Color(0.98, 0.91, 0.72))

	# Roads follow the radial district links generated by OpenWorldRegions.
	for region in REGION_MARKERS:
		if str(region.id) == "willow_village":
			continue
		var center: Vector2 = region.center
		var road := PackedVector2Array([
			_world_to_screen(Vector2.ZERO, origin, map_scale),
			_world_to_screen(center, origin, map_scale)
		])
		draw_polyline(road, Color(0.15, 0.16, 0.14, 0.95), maxf(3.0, map_scale * 2.4), true)
		draw_polyline(road, Color(0.78, 0.70, 0.49, 0.72), maxf(1.0, map_scale * 0.7), true)

	# Willow Village is the central point linking the four districts.
	var village_pos := _world_to_screen(Vector2.ZERO, origin, map_scale)
	draw_circle(village_pos, maxf(7.0, map_scale * 4.0), Color(0.91, 0.70, 0.24))
	draw_circle(village_pos, maxf(3.0, map_scale * 1.8), Color(0.08, 0.10, 0.08))
	_draw_label("WILLOW VILLAGE", village_pos + Vector2(0.0, -14.0), 14, Color(1.0, 0.87, 0.48))

	# Current player location is read from the live Player node each frame.
	var player := get_tree().get_first_node_in_group("player") as Node3D
	if player != null and is_instance_valid(player):
		var player_pos := _world_to_screen(Vector2(player.global_position.x, player.global_position.z), origin, map_scale)
		var heading := Vector2(-sin(player.global_rotation.y), -cos(player.global_rotation.y)).normalized()
		var side := Vector2(-heading.y, heading.x) * 6.0
		var arrow := PackedVector2Array([
			player_pos + heading * 13.0,
			player_pos - heading * 7.0 + side,
			player_pos - heading * 7.0 - side
		])
		draw_colored_polygon(arrow, Color(0.92, 0.95, 1.0))
		draw_circle(player_pos, 12.0, Color(0.92, 0.95, 1.0, 0.18), false, 2.0, true)
		_draw_label("PLAYER", player_pos + Vector2(0.0, 21.0), 11, Color(0.94, 0.95, 1.0))

	# North indicator.
	_draw_label("N", Vector2(size.x - 28.0, 28.0), 16, Color(0.95, 0.84, 0.55))
	draw_line(Vector2(size.x - 28.0, 36.0), Vector2(size.x - 28.0, 50.0), Color(0.95, 0.84, 0.55), 2.0)

func _world_to_screen(world_position: Vector2, origin: Vector2, map_scale: float) -> Vector2:
	return origin + (world_position - _center_world) * map_scale

func _world_rect(center: Vector2, extents: Vector2, origin: Vector2, map_scale: float) -> Rect2:
	var top_left := _world_to_screen(center - extents * 0.5, origin, map_scale)
	return Rect2(top_left, extents * map_scale)

func _draw_world_polygon(points: Array, origin: Vector2, map_scale: float, tint: Color) -> void:
	var polygon := PackedVector2Array()
	for point in points:
		polygon.append(_world_to_screen(point, origin, map_scale))
	draw_colored_polygon(polygon, tint)

func _draw_label(caption: String, at: Vector2, font_size: int, tint: Color) -> void:
	var font := get_theme_default_font()
	if font != null:
		draw_string(font, at, caption, HORIZONTAL_ALIGNMENT_CENTER, -1.0, font_size, tint)
